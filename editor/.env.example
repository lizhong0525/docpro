# DeepSeek API（选填，留空时可使用本地规则）：从 https://platform.deepseek.com/api_keys 获取
DEEPSEEK_API_KEY=
# 可选：兼容的 OpenAI 格式网关地址
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 可选：服务端口
PORT=4399
# 可选：默认模型 deepseek-flash | deepseek-v4-pro
DOCPRO_MODEL=deepseek-flash
# 可选：论文助手正文修订模型（默认 deepseek-v4-pro，强推理）
DOCPRO_PAPER_MODEL=deepseek-v4-pro
# 可选：论文助手参考文献重排模型（默认 deepseek-flash，低延迟省成本）
DOCPRO_PAPER_REFS_MODEL=deepseek-flash
# 可选：论文助手逐段修订默认思考强度 off | low | high | max（默认 low）
DOCPRO_PAPER_THINKING=low
# 可选：docx 导入大小上限（字节），默认 25MB
DOCPRO_MAX_DOCX_BYTES=26214400
# 可选：单次生成超时（毫秒），默认 10 分钟；不限制输出长度，长文需要更久
DOCPRO_TIMEOUT_MS=600000
# 可选：文档库根目录（默认：开发模式为项目 data/，安装版为「文档\DocPro」）
# DOCPRO_DATA_DIR=D:\DocProData
